{
  "name": "flowlet",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter \"@flowlet/api\" --filter \"@flowlet/web\" dev",
