# Local development defaults only. They match docker-compose.yml.
# Never put real credentials in this file.

# PostgreSQL container (read by docker compose)
POSTGRES_USER=flowlet
POSTGRES_PASSWORD=flowlet
POSTGRES_DB=flowlet

# API (apps/api)
PORT=4000
DATABASE_URL=postgres://flowlet:flowlet@localhost:5432/flowlet
MONGO_URL=mongodb://localhost:27017
MONGO_DB=flowlet
# Origin of the web app, allowed by CORS
WEB_ORIGIN=http://localhost:3000

# Web (apps/web): where the browser reaches the API
NEXT_PUBLIC_API_URL=http://localhost:4000
